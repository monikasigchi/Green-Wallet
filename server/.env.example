# Copy to server/.env and set a strong random secret
MONGODB_URI=mongodb://127.0.0.1:27017/green_wallet
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
PORT=5000
NODE_ENV=development
COOKIE_SAME_SITE=lax
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
PAPER_POINTS_PER_KG=10
NEWSPAPERS_POINTS_PER_KG=10
CARDBOARD_POINTS_PER_KG=8
METAL_POINTS_PER_KG=15
RIGID_PLASTIC_POINTS_PER_KG=12
OTHER_DRY_POINTS_PER_KG=5
